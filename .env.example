# Copy to .env and fill in; .env is git-ignored. Load it with:
#   set -a; . ./.env; set +a
# Ask for a sandbox key (fg_test_...) at https://diamondexchapi.live/telegram
DIAMONDEXCHAPI_KEY=

# Optional. Defaults to the sandbox; for live use https://api.diamondexchapi.live with a fg_live_ key.
# DIAMONDEXCHAPI_BASE_URL=https://api-sandbox.diamondexchapi.live

# Optional. Which sport the in-play examples look at (empty = all).
# SPORT=
